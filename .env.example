# Masalan Business Enterprise — environment configuration
# Copy this file to `.env` and fill in your own values.
# IMPORTANT: never commit `.env` to version control.

# Supabase project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=

# Supabase publishable (anon/client) key.
# The publishable key is safe to ship to the browser.
# NEVER put a service_role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
